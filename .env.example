# =============================================================================
# AEROPULSE Environment Configuration Template
# Copy to .env and replace every placeholder before starting the stack.
# =============================================================================

##############################################################################
# PostgreSQL
# POSTGRES_HOST is the internal Docker DNS name, NOT localhost.
# Host-side tools should connect to 127.0.0.1:${POSTGRES_PORT}.
##############################################################################
POSTGRES_USER=aeropulse
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=aeropulse
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Bind to 127.0.0.1 by default so the DB is not exposed to the LAN
POSTGRES_BIND_ADDR=127.0.0.1

##############################################################################
# Redis
##############################################################################
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password

##############################################################################
# Qdrant
##############################################################################
QDRANT_PORT_6333=6333
QDRANT_PORT_6334=6334
QDRANT_API_KEY=change_me_qdrant_api_key

##############################################################################
# Kafka (KRaft, 3-node cluster)
# Do NOT rotate KAFKA_CLUSTER_ID unless you are prepared to wipe all data.
##############################################################################
KAFKA_CLUSTER_ID=aeropulse-kraft-cluster
KAFKA_BOOTSTRAP_SERVERS=kafka-1:9092,kafka-2:9092,kafka-3:9092
KAFKA_TOPIC=aeropulse_state
KAFKA_PORT_ONE=9094
KAFKA_PORT_TWO=9095
KAFKA_PORT_THREE=9096
KAFKA_CONTROLLER_QUORUM_VOTERS=1@kafka-1:9093,2@kafka-2:9093,3@kafka-3:9093
KAFKA_LISTENERS=INTERNAL://0.0.0.0:9092,EXTERNAL://0.0.0.0:9094,CONTROLLER://0.0.0.0:9093
KAFKA_ADVERTISED_LISTENERS=INTERNAL://kafka-1:9092,EXTERNAL://localhost:9094
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=INTERNAL:PLAINTEXT,EXTERNAL:PLAINTEXT,CONTROLLER:PLAINTEXT

##############################################################################
# Poller
##############################################################################
POLLER_PORT=8000

##############################################################################
# Airflow
##############################################################################
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=change_me_airflow_password
AIRFLOW_ADMIN_FIRSTNAME=Admin
AIRFLOW_ADMIN_LASTNAME=User
AIRFLOW_EMAIL=admin@example.com
AIRFLOW_PORT=8080
# Fernet key: used to encrypt connections/variables. 32-byte urlsafe b64.
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=change_me_generate_32_byte_urlsafe_b64_fernet_key
# Webserver session signing key
AIRFLOW_SECRET_KEY=change_me_airflow_secret_key

##############################################################################
# FastAPI
##############################################################################
API_PORT=8001

##############################################################################
# Dashboard
##############################################################################
DASHBOARD_PORT=8501

##############################################################################
# Monitoring
##############################################################################
PROMETHEUS_PORT=9090
GRAFANA_USERNAME=admin
GRAFANA_PASSWORD=change_me_grafana_password
GRAFANA_PORT=3000
LOKI_PORT=3100