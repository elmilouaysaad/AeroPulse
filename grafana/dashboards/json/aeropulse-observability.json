{
  "id": null,
  "uid": "aeropulse-full-ops",
  "title": "AeroPulse — Full Pipeline Observability",
  "tags": ["aeropulse", "kafka", "spark", "airflow", "fastapi", "logs"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Scrape Targets Up",
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "up",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Aircraft Observed per Poll",
      "gridPos": { "h": 7, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "max(aeropulse_aircraft_count)",
          "legendFormat": "aircraft in radius"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15 }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Polls & Kafka Messages Produced / sec",
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(aeropulse_polls_total[5m]))",
          "legendFormat": "polls/s"
        },
        {
          "refId": "B",
          "expr": "sum(rate(aeropulse_kafka_messages_produced_total[5m]))",
          "legendFormat": "kafka msgs/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15 }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Kafka Producer Queue & Parse Errors",
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "max(aeropulse_kafka_producer_queue_size)",
          "legendFormat": "producer queue size"
        },
        {
          "refId": "B",
          "expr": "sum(rate(aeropulse_parse_errors_total[5m])) * 60",
          "legendFormat": "parse errors/min"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15 }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "API Request Rate by Route (req/sec)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total[5m])) by (handler, method)",
          "legendFormat": "{{method}} {{handler}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "API Latency (p50 / p95 / p99)",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Kafka Delivery Latency p95 & API Payload",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(aeropulse_kafka_delivery_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "kafka delivery p95 (s)"
        },
        {
          "refId": "B",
          "expr": "sum(rate(http_response_size_bytes_sum[5m]))",
          "legendFormat": "api response bytes/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Spark Driver JVM Heap Memory",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "last_over_time({__name__=~\"metrics_local_.*_driver_jvm_heap_used_Value\"}[5m])",
          "legendFormat": "heap used"
        },
        {
          "refId": "B",
          "expr": "last_over_time({__name__=~\"metrics_local_.*_driver_jvm_heap_committed_Value\"}[5m])",
          "legendFormat": "heap committed"
        },
        {
          "refId": "C",
          "expr": "last_over_time({__name__=~\"metrics_local_.*_driver_jvm_heap_max_Value\"}[5m])",
          "legendFormat": "heap max"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Spark G1 GC Time & Streaming Listener p95",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "max({__name__=~\"metrics_local_.*_driver_jvm_G1_Young_Generation_time_Value\"})",
          "legendFormat": "young GC"
        },
        {
          "refId": "B",
          "expr": "max({__name__=~\"metrics_local_.*_driver_jvm_G1_Old_Generation_time_Value\"})",
          "legendFormat": "old GC"
        },
        {
          "refId": "C",
          "expr": "max(last_over_time({__name__=~\"metrics_local_.*_driver_LiveListenerBus_listenerProcessingTime_org_apache_spark_sql_execution_streaming_StreamingQueryListenerBus_95thPercentile\"}[5m]))",
          "legendFormat": "streaming listener p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Python Process Resident Memory (API / Poller)",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Error Log Rate by Container (lines/min)",
      "gridPos": { "h": 8, "w": 10, "x": 0, "y": 23 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container) (count_over_time({container=~\"aeropulse-.*\"} |~ \"(?i)(error|exception|traceback|fatal|failed)\" [1m]))",
          "legendFormat": "{{container}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "opm",
          "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 50 }
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "logs",
      "title": "All Error & Exception Logs (All Containers)",
      "gridPos": { "h": 8, "w": 14, "x": 10, "y": 23 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "{container=~\"aeropulse-.*\"} |~ \"(?i)(error|exception|traceback|fatal|oom|refused)\""
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 13,
      "type": "logs",
      "title": "Airflow Logs (aeropulse-airflow)",
      "gridPos": { "h": 9, "w": 8, "x": 0, "y": 31 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "{container=\"aeropulse-airflow\"}"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 14,
      "type": "logs",
      "title": "Spark Errors & Warnings (aeropulse-spark)",
      "gridPos": { "h": 9, "w": 8, "x": 8, "y": 31 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "{container=\"aeropulse-spark\"} |~ \"(?i)(warn|error|exception|failed|executor|oom|jdbc)\""
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 15,
      "type": "logs",
      "title": "Poller & FastAPI Logs",
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 31 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "{container=~\"aeropulse-(poller|api)\"}"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    }
  ]
}